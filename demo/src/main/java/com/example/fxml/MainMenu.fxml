<?xml version="1.0" encoding="UTF-8"?>
<!-- Main menu screen layout; MainMenu supplies save, continue, settings, and audio actions. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="438.0" prefWidth="586.0" styleClass="pane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.MainMenu">

    <children>

        <!-- Background -->
        <ImageView fitHeight="439.0" fitWidth="590.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../css/coded.gif" />
            </image>
        </ImageView>

        <!-- Main menu buttons -->
        <Button fx:id="NewGame" layoutX="217.0" layoutY="103.0" mnemonicParsing="false" onAction="#onNewGameClicked" prefHeight="52.0" prefWidth="156.0" stylesheets="@../css/menu_buttons.css" text="New Game" />

        <Button fx:id="LoadGame" layoutX="231.0" layoutY="163.0" mnemonicParsing="false" onAction="#onLoadGameClicked" stylesheets="@../css/menu_buttons.css" text="Load Game" />

        <Button fx:id="ContinueGame" layoutX="231.0" layoutY="223.0" managed="false" mnemonicParsing="false" onAction="#onContinueGameClicked" prefHeight="50.0" prefWidth="130.0" stylesheets="@../css/menu_buttons.css" text="Continue" visible="true" />

        <Button fx:id="Settings" layoutX="231.0" layoutY="283.0" mnemonicParsing="false" onAction="#onSettingsClicked" prefHeight="50.0" prefWidth="135.0" stylesheets="@../css/menu_buttons.css" text="Settings" />

        <Button fx:id="About" layoutX="231.0" layoutY="345.0" mnemonicParsing="false" onAction="#onAboutClicked" prefHeight="50.0" prefWidth="135.0" stylesheets="@../css/menu_buttons.css" text="About" />

        <!-- Music -->
        <ToggleButton fx:id="MusicToggle" layoutX="507.0" layoutY="380.0" mnemonicParsing="false" onAction="#clickSound" prefHeight="33.0" prefWidth="37.0" style="-fx-background-color: black;" text="🎵" textFill="WHITE" />

        <!-- Sound -->
        <ToggleButton fx:id="SoundToggle" layoutX="466.0" layoutY="380.0" mnemonicParsing="false" onAction="#clickSound" prefHeight="33.0" prefWidth="37.0" style="-fx-background-color: black;" text="🔊" textFill="WHITE" />

        <!-- NEW GAME POPUP -->
        <Pane fx:id="savePane" layoutX="93.0" layoutY="79.0" prefHeight="280.0" prefWidth="400.0" style="-fx-background-color: white;                      -fx-border-color: black;                      -fx-border-width: 3;" visible="false">

            <children>

                <Label layoutX="95.0" layoutY="30.0" style="-fx-font-size: 24px;" text="Create New Game" />

                <Label layoutX="45.0" layoutY="90.0" style="-fx-font-size: 18px;" text="Username:" />

                <TextField fx:id="usernameField" layoutX="145.0" layoutY="85.0" prefHeight="30.0" prefWidth="210.0" promptText="Enter username" />

                <Button layoutX="120.0" layoutY="145.0" onAction="#onSaveGameClicked" prefHeight="40.0" prefWidth="160.0" text="Save" />

                <Button layoutX="120.0" layoutY="200.0" onAction="#onCancelSaveClicked" prefHeight="35.0" prefWidth="160.0" text="Cancel" />

            </children>
        </Pane>

<!-- LOAD GAME POPUP -->
<Pane fx:id="loadPane" layoutX="93.0" layoutY="49.0" prefHeight="340.0" prefWidth="400.0" style="-fx-background-color: white;              -fx-border-color: black;              -fx-border-width: 3;" visible="false">

    <children>

        <Label layoutX="120.0" layoutY="25.0" style="-fx-font-size: 24px;" text="Load Game" />

        <ListView fx:id="saveList" layoutX="45.0" layoutY="70.0" prefHeight="170.0" prefWidth="310.0" />

        <Button fx:id="loadSelectedGame" layoutX="45.0" layoutY="260.0" onAction="#onLoadSelectedGameClicked" prefHeight="40.0" prefWidth="145.0" text="Load" />

        <Button layoutX="210.0" layoutY="260.0" onAction="#onCancelLoadClicked" prefHeight="40.0" prefWidth="145.0" text="Cancel" />

    </children>
</Pane>

        <!-- SETTINGS POPUP -->
        <Pane fx:id="settingsPane" layoutX="48.0" layoutY="43.0" prefHeight="352.0" prefWidth="490.0" style="-fx-background-color: white;                      -fx-border-color: black;                      -fx-border-width: 3;" visible="false">
            <children>
                <Label layoutX="185.0" layoutY="18.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="SETTINGS" />

                <Label layoutX="48.0" layoutY="68.0" text="Volume:" />
                <Slider fx:id="volumeSlider" layoutX="155.0" layoutY="64.0" max="1.0" prefWidth="280.0" value="0.75" />

                <Label layoutX="48.0" layoutY="111.0" text="Difficulty:" />
                <ComboBox fx:id="difficultyComboBox" layoutX="155.0" layoutY="106.0" prefWidth="280.0" />

                <Label layoutX="48.0" layoutY="154.0" text="Language:" />
                <ComboBox fx:id="languageComboBox" layoutX="155.0" layoutY="149.0" prefWidth="280.0" />

                <Label layoutX="48.0" layoutY="197.0" text="Resolution:" />
                <ComboBox fx:id="resolutionComboBox" layoutX="155.0" layoutY="192.0" prefWidth="280.0" />

                <Label layoutX="48.0" layoutY="240.0" text="Fullscreen:" />
                <ComboBox fx:id="fullscreenComboBox" layoutX="155.0" layoutY="235.0" prefWidth="280.0" />

                <Button layoutX="47.0" layoutY="290.0" onAction="#onSettingsResetClicked" prefHeight="38.0" prefWidth="110.0" text="Reset" />
                <Button layoutX="190.0" layoutY="290.0" onAction="#onSettingsSaveClicked" prefHeight="38.0" prefWidth="110.0" text="Save" />
                <Button layoutX="333.0" layoutY="290.0" onAction="#onSettingsCancelClicked" prefHeight="38.0" prefWidth="110.0" text="Cancel" />
            </children>
        </Pane>

        <!-- ABOUT POPUP -->
        <Pane fx:id="aboutPane" layoutX="48.0" layoutY="43.0" prefHeight="352.0" prefWidth="490.0" style="-fx-background-color: white;                      -fx-border-color: black;                      -fx-border-width: 3;" visible="false">
            <children>
                <Label layoutX="170.0" layoutY="14.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="About the game" />
                <ScrollPane fitToWidth="true" layoutX="20.0" layoutY="55.0" prefHeight="230.0" prefWidth="445.0">
                    <content>
                        <VBox spacing="8.0" style="-fx-padding: 8 12 8 8;">
                            <children>
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Purpose" />
                                <Label text="This game was created for the Department of Informatics and Telecommunications at the University of Peloponnese as a final paper." wrapText="true" />
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Idea" />
                                <Label text="Inspired by CodeCombat, this is a 2.5D adventure game where players learn coding by playing through levels." wrapText="true" />
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Story" />
                                <Label text="You begin in a hell-like environment, facing hostile surroundings and bugs as enemies. Code your way out; in the end, you wake from the nightmare knowing how to fix your code and defeat those bugs." wrapText="true" />
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Mechanics" />
                                <Label text="Each level is a grid designed to teach something new and challenge the player. Scores are based on steps: gold for a perfect run, silver for one extra step, and bronze for completing the level. Write code in the input beside the map; if the goal is not reached, the level resets so you can try again." wrapText="true" />
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
                <Button layoutX="180.0" layoutY="298.0" onAction="#onAboutCloseClicked" prefHeight="38.0" prefWidth="130.0" text="Back" />
            </children>
        </Pane>

    </children>
</Pane>
