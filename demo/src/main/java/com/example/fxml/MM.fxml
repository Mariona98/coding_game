<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="438.0"
      prefWidth="586.0"
      styleClass="pane"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.MainMenu">

    <children>

        <!-- Background -->
        <ImageView fitHeight="439.0"
                    fitWidth="590.0"
                    layoutY="-1.0"
                    pickOnBounds="true"
                    preserveRatio="true">
            <image>
                <Image url="@../css/coded.gif" />
            </image>
        </ImageView>

        <!-- Main menu buttons -->
        <Button fx:id="NewGame"
                layoutX="217.0"
                layoutY="103.0"
                mnemonicParsing="false"
                onAction="#onNewGameClicked"
                prefHeight="52.0"
                prefWidth="156.0"
                styleClass="learn-more"
                stylesheets="@../css/menu_buttons.css"
                text="New Game"/>

        <Button fx:id="LoadGame"
                layoutX="231.0"
                layoutY="163.0"
                mnemonicParsing="false"
                onAction="#onLoadGameClicked"
                stylesheets="@../css/menu_buttons.css"
                text="Load Game"/>

        <Button fx:id="Settings"
                layoutX="228.0"
                layoutY="273.0"
                mnemonicParsing="false"
                onAction="#onSettingsClicked"
                prefHeight="50.0"
                prefWidth="135.0"
                stylesheets="@../css/menu_buttons.css"
                text="Settings"/>

        <Button fx:id="About"
                layoutX="228.0"
                layoutY="335.0"
                mnemonicParsing="false"
                onAction="#onAboutClicked"
                prefHeight="50.0"
                prefWidth="135.0"
                stylesheets="@../css/menu_buttons.css"
                text="About"/>

        <!-- Music -->
        <ToggleButton fx:id="MusicToggle"
                      layoutX="507.0"
                      layoutY="385.0"
                      mnemonicParsing="false"
                      onAction="#clickSound"
                      prefHeight="33.0"
                      prefWidth="37.0"
                      style="-fx-background-color: black;"
                      text="🎵"
                      textFill="WHITE"/>

        <!-- Sound -->
        <ToggleButton fx:id="SoundToggle"
                      layoutX="466.0"
                      layoutY="385.0"
                      mnemonicParsing="false"
                      onAction="#clickSound"
                      prefHeight="33.0"
                      prefWidth="37.0"
                      style="-fx-background-color: black;"
                      text="🔊"
                      textFill="WHITE"/>

        <!-- NEW GAME POPUP -->
        <Pane fx:id="savePane"
              layoutX="93.0"
              layoutY="79.0"
              prefWidth="400.0"
              prefHeight="280.0"
              visible="false"
              style="-fx-background-color: white;
                     -fx-border-color: black;
                     -fx-border-width: 3;">

            <children>

                <Label layoutX="95.0"
                       layoutY="30.0"
                       text="Create New Game"
                       style="-fx-font-size: 24px;" />

                <Label layoutX="45.0"
                       layoutY="90.0"
                       text="Username:"
                       style="-fx-font-size: 18px;" />

                <TextField fx:id="usernameField"
                           layoutX="145.0"
                           layoutY="85.0"
                           prefWidth="210.0"
                           prefHeight="30.0"
                           promptText="Enter username"/>

                <Button layoutX="120.0"
                        layoutY="145.0"
                        prefWidth="160.0"
                        prefHeight="40.0"
                        text="Save"
                        onAction="#onSaveGameClicked"/>

                <Button layoutX="120.0"
                        layoutY="200.0"
                        prefWidth="160.0"
                        prefHeight="35.0"
                        text="Cancel"
                        onAction="#onCancelSaveClicked"/>

            </children>
        </Pane>

    </children>
</Pane>